import 'dart:async';
import 'dart:convert';
import 'dart:io';

import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

class WhatsAppFeatureScreen extends StatefulWidget {
  const WhatsAppFeatureScreen({super.key});

  @override
  State<WhatsAppFeatureScreen> createState() => _WhatsAppFeatureScreenState();
}

class _WhatsAppFeatureScreenState extends State<WhatsAppFeatureScreen> {
  static const MethodChannel _whatsAppChannel = MethodChannel(
    'text_helper/whatsapp_handoff',
  );

  final TextEditingController _draftPhoneController = TextEditingController();
  final TextEditingController _draftMessageController = TextEditingController();

  final TextEditingController _backendUrlController = TextEditingController();
  final TextEditingController _businessPhoneController = TextEditingController();
  final TextEditingController _templateNameController = TextEditingController();
  final TextEditingController _languageController = TextEditingController();
  final TextEditingController _templateParamsController =
      TextEditingController();

  Timer? _fiveSecondTimer;

  int _selectedMode = 0;
  int _secondsRemaining = 0;

  bool _checkingWhatsApp = true;
  bool _whatsAppInstalled = false;
  bool _openingDraft = false;
  bool _businessSending = false;
  bool _fiveSecondRunning = false;

  String _status =
      'Choose Draft Assist for normal WhatsApp, or Business Sender for automatic WhatsApp Business templates.';

  final List<String> _logs = <String>[];

  @override
  void initState() {
    super.initState();

    _draftPhoneController.text = '+64211234567';
    _draftMessageController.text =
        'Hi, this is a WhatsApp draft prepared by Text Helper.';

    _backendUrlController.text = 'http://YOUR_PC_IP:8787';
    _businessPhoneController.text = '64211234567';
    _templateNameController.text = 'hello_world';
    _languageController.text = 'en_US';
    _templateParamsController.text = '';

    _checkWhatsAppInstalled();
  }

  @override
  void dispose() {
    _fiveSecondTimer?.cancel();
    _draftPhoneController.dispose();
    _draftMessageController.dispose();
    _backendUrlController.dispose();
    _businessPhoneController.dispose();
    _templateNameController.dispose();
    _languageController.dispose();
    _templateParamsController.dispose();
    super.dispose();
  }

  Future<void> _checkWhatsAppInstalled() async {
    setState(() {
      _checkingWhatsApp = true;
    });

    try {
      final installed = await _whatsAppChannel.invokeMethod<bool>(
        'isWhatsAppInstalled',
      );

      if (!mounted) {
        return;
      }

      setState(() {
        _whatsAppInstalled = installed ?? false;
        _checkingWhatsApp = false;
        _status = _whatsAppInstalled
            ? 'WhatsApp detected. Draft Assist is ready.'
            : 'WhatsApp was not detected. Draft Assist needs WhatsApp installed.';
        _log(_status);
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _whatsAppInstalled = false;
        _checkingWhatsApp = false;
        _status = 'Could not check WhatsApp install: $error';
        _log(_status);
      });
    }
  }

  Future<void> _openWhatsAppDraft() async {
    final phone = _draftPhoneController.text.trim();
    final message = _draftMessageController.text.trim();

    if (phone.isEmpty || message.isEmpty) {
      _showSnack('Phone number and message are required.');
      return;
    }

    setState(() {
      _openingDraft = true;
      _status = 'Opening WhatsApp draft...';
    });

    try {
      final opened = await _whatsAppChannel.invokeMethod<bool>(
        'launchWhatsAppHandoff',
        <String, Object?>{
          'phoneNumber': phone,
          'message': message,
        },
      );

      if (!mounted) {
        return;
      }

      setState(() {
        _openingDraft = false;
        _status = opened == true
            ? 'WhatsApp opened. Review the draft and tap Send manually.'
            : 'Could not open WhatsApp draft.';
        _log(_status);
      });
    } catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _openingDraft = false;
        _status = 'WhatsApp draft failed: $error';
        _log(_status);
      });
    }
  }

  Future<void> _testBackendConnection() async {
    final baseUrl = _cleanBaseUrl(_backendUrlController.text);

    if (baseUrl.isEmpty) {
      _showSnack('Backend URL is required.');
      return;
    }

    setState(() {
      _businessSending = true;
      _status = 'Checking backend connection...';
    });

    final result = await _getJson('$baseUrl/health');

    if (!mounted) {
      return;
    }

    setState(() {
      _businessSending = false;
      _status = result.ok
          ? 'Backend connected: ${result.message}'
          : 'Backend check failed: ${result.message}';
      _log(_status);
    });
  }

  Future<void> _sendBusinessTemplateNow() async {
    final baseUrl = _cleanBaseUrl(_backendUrlController.text);
    final phone = _businessPhoneController.text.trim();
    final templateName = _templateNameController.text.trim();
    final languageCode = _languageController.text.trim();
    final parameters = _templateParamsController.text
        .split(',')
        .map((item) => item.trim())
        .where((item) => item.isNotEmpty)
        .toList();

    if (baseUrl.isEmpty) {
      _showSnack('Backend URL is required.');
      return;
    }

    if (phone.isEmpty || templateName.isEmpty || languageCode.isEmpty) {
      _showSnack('Phone, template name, and language code are required.');
      return;
    }

    setState(() {
      _businessSending = true;
      _status = 'Sending WhatsApp Business template...';
    });

    final result = await _postJson(
      '$baseUrl/whatsapp/send-template',
      <String, Object?>{
        'to': phone,
        'templateName': templateName,
        'languageCode': languageCode,
        'bodyParameters': parameters,
      },
    );

    if (!mounted) {
      return;
    }

    setState(() {
      _businessSending = false;
      _status = result.ok
          ? 'Business template sent. ${result.message}'
          : 'Business send failed: ${result.message}';
      _log(_status);
    });
  }

  void _startFiveSecondBusinessTest() {
    if (_fiveSecondRunning) {
      return;
    }

    _fiveSecondTimer?.cancel();

    setState(() {
      _fiveSecondRunning = true;
      _secondsRemaining = 5;
      _status = '5-second Business Sender test started. Keep Text Helper open.';
      _log(_status);
    });

    _fiveSecondTimer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (!mounted) {
        timer.cancel();
        return;
      }

      if (_secondsRemaining <= 1) {
        timer.cancel();

        setState(() {
          _fiveSecondRunning = false;
          _secondsRemaining = 0;
        });

        _sendBusinessTemplateNow();
        return;
      }

      setState(() {
        _secondsRemaining -= 1;
        _status = 'Sending through backend in $_secondsRemaining seconds...';
      });
    });
  }

  void _cancelFiveSecondBusinessTest() {
    _fiveSecondTimer?.cancel();

    setState(() {
      _fiveSecondRunning = false;
      _secondsRemaining = 0;
      _status = '5-second test cancelled.';
      _log(_status);
    });
  }

  String _cleanBaseUrl(String value) {
    return value.trim().replaceAll(RegExp(r'/+$'), '');
  }

  Future<_ApiResult> _getJson(String url) async {
    final client = HttpClient();

    try {
      final request = await client.getUrl(Uri.parse(url));
      final response = await request.close();
      final body = await response.transform(utf8.decoder).join();
      final decoded = _decodeMap(body);

      return _ApiResult(
        ok: response.statusCode >= 200 && response.statusCode < 300,
        message: decoded?['message']?.toString() ?? body,
      );
    } catch (error) {
      return _ApiResult(ok: false, message: error.toString());
    } finally {
      client.close(force: true);
    }
  }

  Future<_ApiResult> _postJson(String url, Map<String, Object?> payload) async {
    final client = HttpClient();

    try {
      final request = await client.postUrl(Uri.parse(url));
      request.headers.contentType = ContentType.json;
      request.write(jsonEncode(payload));

      final response = await request.close();
      final body = await response.transform(utf8.decoder).join();
      final decoded = _decodeMap(body);

      final providerMessageId = decoded?['providerMessageId']?.toString();

      return _ApiResult(
        ok: response.statusCode >= 200 && response.statusCode < 300,
        message: providerMessageId == null
            ? decoded?['message']?.toString() ??
                decoded?['error']?.toString() ??
                body
            : 'Provider id: $providerMessageId',
      );
    } catch (error) {
      return _ApiResult(ok: false, message: error.toString());
    } finally {
      client.close(force: true);
    }
  }

  Map<String, dynamic>? _decodeMap(String body) {
    try {
      final decoded = jsonDecode(body);
      if (decoded is Map<String, dynamic>) {
        return decoded;
      }
    } catch (_) {}

    return null;
  }

  void _log(String value) {
    final stamp = DateTime.now().toIso8601String().substring(11, 19);
    _logs.insert(0, '$stamp  $value');

    if (_logs.length > 20) {
      _logs.removeRange(20, _logs.length);
    }
  }

  void _loadTemplate(String message) {
    _draftMessageController.text = message;
    setState(() {
      _status = 'Template loaded.';
      _log(_status);
    });
  }

  void _showSnack(String message) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(message),
        behavior: SnackBarBehavior.floating,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final isDraftAssist = _selectedMode == 0;

    return Scaffold(
      backgroundColor: const Color(0xFFF2F2F7),
      appBar: AppBar(
        title: const Text('WhatsApp'),
        centerTitle: false,
        actions: [
          IconButton(
            onPressed: _checkingWhatsApp ? null : _checkWhatsAppInstalled,
            icon: const Icon(CupertinoIcons.refresh),
          ),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          const _HeroCard(),
          const SizedBox(height: 16),
          _StatusCard(status: _status),
          const SizedBox(height: 16),
          _ModeSwitcher(
            selectedMode: _selectedMode,
            onChanged: (value) {
              setState(() {
                _selectedMode = value;
                _status = value == 0
                    ? 'Draft Assist selected. Normal WhatsApp requires manual Send.'
                    : 'Business Sender selected. Automatic sends require your backend and WhatsApp Business API.';
                _log(_status);
              });
            },
          ),
          const SizedBox(height: 16),
          if (isDraftAssist)
            _buildDraftAssist()
          else
            _buildBusinessSender(),
          const SizedBox(height: 20),
          const _SectionTitle('Activity'),
          const SizedBox(height: 12),
          _SurfaceCard(
            child: _logs.isEmpty
                ? const Text(
                    'No activity yet.',
                    style: TextStyle(
                      color: CupertinoColors.secondaryLabel,
                      fontWeight: FontWeight.w700,
                    ),
                  )
                : Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: _logs
                        .map(
                          (log) => Padding(
                            padding: const EdgeInsets.only(bottom: 8),
                            child: Text(
                              log,
                              style: const TextStyle(
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                          ),
                        )
                        .toList(),
                  ),
          ),
        ],
      ),
    );
  }

  Widget _buildDraftAssist() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _SurfaceCard(
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Icon(
                _whatsAppInstalled
                    ? CupertinoIcons.check_mark_circled_solid
                    : CupertinoIcons.info_circle_fill,
                color: _whatsAppInstalled
                    ? const Color(0xFF16A34A)
                    : const Color(0xFFF97316),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: Text(
                  _whatsAppInstalled
                      ? 'WhatsApp detected. Draft Assist can open prepared messages.'
                      : 'WhatsApp was not detected. Install WhatsApp to use Draft Assist.',
                  style: const TextStyle(
                    height: 1.35,
                    fontWeight: FontWeight.w800,
                  ),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 16),
        const _SectionTitle('Draft Assist'),
        const SizedBox(height: 12),
        _SurfaceCard(
          child: Column(
            children: [
              TextField(
                controller: _draftPhoneController,
                keyboardType: TextInputType.phone,
                decoration: const InputDecoration(
                  labelText: 'WhatsApp number',
                  helperText: 'Use international format, for example +64211234567.',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: _draftMessageController,
                maxLines: 5,
                decoration: const InputDecoration(
                  labelText: 'Draft message',
                  helperText: 'This will open in WhatsApp for manual review.',
                ),
              ),
              const SizedBox(height: 14),
              Wrap(
                spacing: 10,
                runSpacing: 10,
                children: [
                  ActionChip(
                    label: const Text('Appointment'),
                    onPressed: () => _loadTemplate(
                      'Hi, this is a reminder about your appointment. Please reply if you need to change it.',
                    ),
                  ),
                  ActionChip(
                    label: const Text('Follow up'),
                    onPressed: () => _loadTemplate(
                      'Hi, just following up. Let me know when you have a chance.',
                    ),
                  ),
                  ActionChip(
                    label: const Text('Confirmation'),
                    onPressed: () => _loadTemplate(
                      'Hi, this confirms your booking. Please reply if anything changes.',
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 16),
              FilledButton.icon(
                onPressed: _openingDraft ? null : _openWhatsAppDraft,
                icon: _openingDraft
                    ? const SizedBox(
                        width: 18,
                        height: 18,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                    : const Icon(CupertinoIcons.arrow_up_right_square_fill),
                label: Text(
                  _openingDraft ? 'Opening...' : 'Open WhatsApp Draft',
                ),
                style: FilledButton.styleFrom(
                  minimumSize: const Size.fromHeight(56),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(18),
                  ),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 12),
        const _PolicyCard(
          text:
              'Draft Assist uses normal WhatsApp. Text Helper prepares the draft and opens WhatsApp. The user must press Send.',
        ),
      ],
    );
  }

  Widget _buildBusinessSender() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const _SectionTitle('Business Sender'),
        const SizedBox(height: 12),
        _SurfaceCard(
          child: Column(
            children: [
              TextField(
                controller: _backendUrlController,
                decoration: const InputDecoration(
                  labelText: 'Backend URL',
                  helperText:
                      'Example: http://192.168.1.25:8787. Do not use localhost on a phone.',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: _businessPhoneController,
                keyboardType: TextInputType.phone,
                decoration: const InputDecoration(
                  labelText: 'Recipient phone',
                  helperText: 'Use international format without plus, for example 64211234567.',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: _templateNameController,
                decoration: const InputDecoration(
                  labelText: 'Approved template name',
                  helperText: 'Must exist in WhatsApp Business Manager.',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: _languageController,
                decoration: const InputDecoration(
                  labelText: 'Language code',
                  helperText: 'Example: en_US.',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: _templateParamsController,
                decoration: const InputDecoration(
                  labelText: 'Template parameters',
                  helperText: 'Comma separated. Leave blank if template has no variables.',
                ),
              ),
              const SizedBox(height: 16),
              FilledButton.icon(
                onPressed: _businessSending ? null : _testBackendConnection,
                icon: const Icon(CupertinoIcons.link),
                label: const Text('Test Backend'),
                style: FilledButton.styleFrom(
                  minimumSize: const Size.fromHeight(54),
                ),
              ),
              const SizedBox(height: 10),
              FilledButton.icon(
                onPressed: _businessSending ? null : _sendBusinessTemplateNow,
                icon: _businessSending
                    ? const SizedBox(
                        width: 18,
                        height: 18,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                    : const Icon(CupertinoIcons.paperplane_fill),
                label: Text(_businessSending ? 'Sending...' : 'Send Through Backend'),
                style: FilledButton.styleFrom(
                  minimumSize: const Size.fromHeight(54),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 16),
        const _SectionTitle('5-second test'),
        const SizedBox(height: 12),
        _SurfaceCard(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                _fiveSecondRunning
                    ? 'Sending through backend in $_secondsRemaining seconds...'
                    : 'Keep Text Helper open. This waits 5 seconds, then sends through your backend without opening WhatsApp.',
                style: const TextStyle(
                  height: 1.35,
                  fontWeight: FontWeight.w800,
                ),
              ),
              const SizedBox(height: 14),
              Row(
                children: [
                  Expanded(
                    child: FilledButton.icon(
                      onPressed: _fiveSecondRunning || _businessSending
                          ? null
                          : _startFiveSecondBusinessTest,
                      icon: const Icon(CupertinoIcons.timer),
                      label: const Text('Start 5 Sec Test'),
                    ),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: OutlinedButton.icon(
                      onPressed: _fiveSecondRunning
                          ? _cancelFiveSecondBusinessTest
                          : null,
                      icon: const Icon(CupertinoIcons.xmark_circle),
                      label: const Text('Cancel'),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
        const SizedBox(height: 12),
        const _PolicyCard(
          text:
              'Business Sender does not control the installed WhatsApp app. It sends approved templates through your backend and the official WhatsApp Business API.',
        ),
      ],
    );
  }
}

class _ApiResult {
  const _ApiResult({
    required this.ok,
    required this.message,
  });

  final bool ok;
  final String message;
}

class _HeroCard extends StatelessWidget {
  const _HeroCard();

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(22),
      decoration: const BoxDecoration(
        color: Color(0xFF075E54),
        borderRadius: BorderRadius.all(Radius.circular(30)),
      ),
      child: const Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Icon(
            CupertinoIcons.chat_bubble_2_fill,
            color: Colors.white,
            size: 36,
          ),
          SizedBox(height: 16),
          Text(
            'WhatsApp',
            style: TextStyle(
              color: Colors.white,
              fontSize: 34,
              fontWeight: FontWeight.w900,
              letterSpacing: -0.8,
            ),
          ),
          SizedBox(height: 8),
          Text(
            'Draft Assist for normal WhatsApp. Business Sender for approved automatic template messaging.',
            style: TextStyle(
              color: Colors.white70,
              height: 1.35,
              fontWeight: FontWeight.w700,
            ),
          ),
        ],
      ),
    );
  }
}

class _ModeSwitcher extends StatelessWidget {
  const _ModeSwitcher({
    required this.selectedMode,
    required this.onChanged,
  });

  final int selectedMode;
  final ValueChanged<int> onChanged;

  @override
  Widget build(BuildContext context) {
    return CupertinoSlidingSegmentedControl<int>(
      groupValue: selectedMode,
      children: const {
        0: Padding(
          padding: EdgeInsets.symmetric(horizontal: 8, vertical: 10),
          child: Text(
            'Draft Assist',
            style: TextStyle(fontWeight: FontWeight.w900),
          ),
        ),
        1: Padding(
          padding: EdgeInsets.symmetric(horizontal: 8, vertical: 10),
          child: Text(
            'Business Sender',
            style: TextStyle(fontWeight: FontWeight.w900),
          ),
        ),
      },
      onValueChanged: (value) {
        if (value == null) {
          return;
        }

        onChanged(value);
      },
    );
  }
}

class _PolicyCard extends StatelessWidget {
  const _PolicyCard({required this.text});

  final String text;

  @override
  Widget build(BuildContext context) {
    return _SurfaceCard(
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Icon(
            CupertinoIcons.exclamationmark_shield_fill,
            color: Color(0xFFF97316),
          ),
          const SizedBox(width: 14),
          Expanded(
            child: Text(
              text,
              style: const TextStyle(
                color: CupertinoColors.secondaryLabel,
                height: 1.35,
                fontWeight: FontWeight.w800,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _StatusCard extends StatelessWidget {
  const _StatusCard({required this.status});

  final String status;

  @override
  Widget build(BuildContext context) {
    return _SurfaceCard(
      child: Row(
        children: [
          const Icon(
            CupertinoIcons.info_circle_fill,
            color: Color(0xFF0A84FF),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Text(
              status,
              style: const TextStyle(
                height: 1.3,
                fontWeight: FontWeight.w800,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _SectionTitle extends StatelessWidget {
  const _SectionTitle(this.title);

  final String title;

  @override
  Widget build(BuildContext context) {
    return Text(
      title,
      style: const TextStyle(
        fontSize: 21,
        fontWeight: FontWeight.w900,
        letterSpacing: -0.2,
      ),
    );
  }
}

class _SurfaceCard extends StatelessWidget {
  const _SurfaceCard({required this.child});

  final Widget child;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: const BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.all(Radius.circular(24)),
        boxShadow: [
          BoxShadow(
            color: Color(0x12000000),
            blurRadius: 16,
            offset: Offset(0, 8),
          ),
        ],
      ),
      child: child,
    );
  }
}

